{
 "schema": "facade-style-1",
 "id": "fx-style",
 "version": "1.0.0",
 "kind": "style",
 "title": "fixture style",
 "label": "STYLE-GENERATED (not observed)",
 "license": "original (Moria)",
 "evidence": {
  "class": "style"
 },
 "applies_to": {
  "building": [
   "yes"
  ],
  "max_levels": 8,
  "min_face_len": 6
 },
 "palette": "lib:fx-tan",
 "components": {
  "win": {
   "ref": "lib:fx-window-2x3"
  },
  "door": {
   "ref": "lib:fx-door"
  },
  "band": {
   "ref": "lib:fx-band"
  },
  "corner": {
   "ref": "lib:fx-corner"
  },
  "parapet": {
   "ref": "lib:fx-parapet"
  },
  "lintel": {
   "ref": "lib:fx-stair-lintel"
  }
 },
 "defaults": {
  "exterior": {
   "floors": {
    "base_v": 0,
    "height": 4,
    "count": "auto"
   },
   "bays": {
    "width": 4,
    "residual": "center"
   },
   "ground": {
    "openings": [
     {
      "component": "win",
      "bays": "all",
      "v": 0
     },
     {
      "component": "door",
      "bays": "center",
      "replace": "win"
     }
    ]
   },
   "upper": {
    "openings": [
     {
      "component": "win",
      "bays": "all",
      "v": 0,
      "above": "lintel"
     }
    ]
   },
   "bands": [
    {
     "component": "band",
     "at": "floor_lines"
    }
   ],
   "corners": {
    "component": "corner"
   },
   "parapet": {
    "component": "parapet"
   }
  },
  "shared": {
   "wall_only": true
  }
 },
 "limits": {
  "note": "styles cannot raise limits"
 }
}